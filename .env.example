# Copy to .env and fill in. .env is gitignored; this file is not.

# Hugging Face model used for task routing. MODEL_NAME is also accepted.
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# Hugging Face access token: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- optional, defaults shown (see src/config.py) ---
# ROLE=user
# TEMPERATURE=0.0
# MAX_TOKENS=256
# REQUEST_TIMEOUT=30
# MAX_RETRIES=2
# Loopback only. This service runs local scripts; do not expose it casually.
# HOST=127.0.0.1
# PORT=5000
