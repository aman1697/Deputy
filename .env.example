# Copy to .env and fill in. .env is gitignored; this file is not.

# Model used for routing and for phrasing the spoken reply. MODEL_NAME is also
# accepted. Append ":<provider>" to pin a Hugging Face inference provider, e.g.
# Qwen/Qwen3.8-27B:novita. No suffix means "auto".
MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Any OpenAI-compatible endpoint. Set this and Hugging Face is bypassed
# entirely - no HF_TOKEN needed, no quota, and task output (including your
# calendar) never leaves the machine.
#
#   ollama pull qwen2.5:3b-instruct
#   MODEL_BASE_URL=http://127.0.0.1:11434/v1
#   MODEL_ID=qwen2.5:3b-instruct
#
# The colon in an Ollama model name is part of the name, not a provider suffix;
# that is handled for you when MODEL_BASE_URL is set.
# MODEL_BASE_URL=
# Text-to-speech model that reads the spoken result aloud. Needs a CUDA GPU.
# AUDIO_MODEL_NAME is also accepted.
AUDIO_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-Base
# Hugging Face access token: https://huggingface.co/settings/tokens
# Not needed when MODEL_BASE_URL points at something that takes no key.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- optional, defaults shown (see src/config.py) ---
# ROLE=user
# TEMPERATURE=0.0
# MAX_TOKENS=256
# Used for the spoken rephrase only; routing stays pinned at TEMPERATURE.
# SPEECH_TEMPERATURE=0.4
# SPEECH_MAX_TOKENS=512
# Speech synthesis. Off by default: it needs a CUDA GPU and flash-attn. The
# reply always carries the spoken text; this only controls whether a .wav is
# rendered. Turn it on once the GPU side is available.
# AUDIO_ENABLED=true
# REQUEST_TIMEOUT=30
# MAX_RETRIES=2
# Loopback only. This service runs local scripts; do not expose it casually.
# HOST=127.0.0.1
# PORT=5000
