# Copy to .env and fill in. .env is gitignored; this file is not.

# Hugging Face model used for task routing. MODEL_NAME is also accepted.
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# Text-to-speech model that reads the spoken result aloud. Needs a CUDA GPU.
# AUDIO_MODEL_NAME is also accepted.
AUDIO_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-Base
# Hugging Face access token: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- optional, defaults shown (see src/config.py) ---
# ROLE=user
# TEMPERATURE=0.0
# MAX_TOKENS=256
# Used for the spoken rephrase only; routing stays pinned at TEMPERATURE.
# SPEECH_TEMPERATURE=0.4
# SPEECH_MAX_TOKENS=512
# Set false on a box without a GPU: the reply still carries the spoken text,
# just no .wav file.
# AUDIO_ENABLED=true
# REQUEST_TIMEOUT=30
# MAX_RETRIES=2
# Loopback only. This service runs local scripts; do not expose it casually.
# HOST=127.0.0.1
# PORT=5000
